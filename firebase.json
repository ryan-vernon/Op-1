{
  "hosting": {
    "public": "public",
    "predeploy": [
      "bash build.sh"
    ],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    }
  },
  "apphosting": {
    "backendId": "op-1",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".claude",
      "dataconnect",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*-debug.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "us-central1"
  },
  "storage": {
    "rules": "storage.rules"
  }
}